:"1.2.0","_view_name":"StyleView","description_width":""}}}}},"cells":[{"cell_type":"markdown","source":["Design Solution A: Deterministic Lexical Retention (Fuzzy Matching)\n","\n","Objective:\n","Measure the survival rate of specific cultural terms (e.g., 'Pitha', 'Ghat', 'Bhut')\n","in the LLM-generated text, accounting for transliteration differences."],"metadata":{"id":"bLOWiL1xoK63"}},{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"jLoxbryLoEu_","executionInfo":{"status":"ok","timestamp":1768992799189,"user_tz":-360,"elapsed":12445,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}},"outputId":"79614e12-53f1-46dc-96fe-4a342fd0ce25"},"outputs":[{"output_type":"stream","name":"stdout","text":["Collecting thefuzz\n","  Downloading thefuzz-0.22.1-py3-none-any.whl.metadata (3.9 kB)\n","Collecting rapidfuzz<4.0.0,>=3.0.0 (from thefuzz)\n","  Downloading rapidfuzz-3.14.3-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl.metadata (12 kB)\n","Downloading thefuzz-0.22.1-py3-none-any.whl (8.2 kB)\n","Downloading rapidfuzz-3.14.3-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl (3.2 MB)\n","\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m3.2/3.2 MB\u001b[0m \u001b[31m33.9 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[?25hInstalling collected packages: rapidfuzz, thefuzz\n","Successfully installed rapidfuzz-3.14.3 thefuzz-0.22.1\n"]}],"source":["pip install thefuzz"]},{"cell_type":"code","source":["import os\n","import json\n","import pandas as pd\n","from typing import Dict, List, Tuple\n","from thefuzz import fuzz # pip install thefuzz\n","from tqdm.auto import tqdm\n","from google.colab import drive"],"metadata":{"id":"AIbPanS-oYx0","executionInfo":{"status":"ok","timestamp":1768992800973,"user_tz":-360,"elapsed":624,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}}},"execution_count":2,"outputs":[]},{"cell_type":"code","source":["# Mount Google Drive\n","if not os.path.exists('/content/drive'):\n","    drive.mount('/content/drive', force_remount = True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"M6mHMZBzoewP","executionInfo":{"status":"ok","timestamp":1768992822269,"user_tz":-360,"elapsed":19366,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}},"outputId":"bcf96472-691b-4e21-89fa-c87d2541eca8"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}]},{"cell_type":"code","source":["# ==========================================\n","# CONFIGURATION\n","# ==========================================\n","BASE_PATH = \"/content/drive/My Drive/Algorithmic Amnesia/Text Corpus\"\n","DATA_PATH = os.path.join(BASE_PATH, \"P2's 10\")\n","RESULTS_PATH = \"/content/drive/My Drive/Algorithmic Amnesia/Evaluation Results/Design_A_Results\"\n","os.makedirs(RESULTS_PATH, exist_ok=True)\n","\n","# FUZZY MATCH THRESHOLD (0-100)\n","# 85 is usually safe for transliterations (e.g., \"Pitha\" vs \"Pithe\")\n","# Lower than 80 might match \"Bhut\" to \"But\" (False Positive)\n","MATCH_THRESHOLD = 85"],"metadata":{"id":"nnUEnETRol2t","executionInfo":{"status":"ok","timestamp":1768992825414,"user_tz":-360,"elapsed":480,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","source":["# ==========================================\n","# UTILITIES\n","# ==========================================\n","\n","def parse_filename(filename: str) -> Dict:\n","    \"\"\"Extract metadata from standardized filenames.\"\"\"\n","    clean_name = filename.replace('.txt', '').replace('.json', '')\n","    parts = clean_name.split('_')\n","\n","    if filename.endswith('.txt'):\n","        return {\n","            'type': 'retelling',\n","            'story': '_'.join(parts[:-3]),\n","            'language': parts[-3],\n","            'prompt': parts[-2],\n","            'model': parts[-1],\n","            'filename': filename\n","        }\n","    else:\n","        return {\n","            'type': 'annotation',\n","            'story': '_'.join(parts[:-1]),\n","            'language': parts[-1],\n","            'filename': filename\n","        }\n","\n","def load_data(lang: str) -> Tuple[Dict, List[Dict]]:\n","    annotations = {}\n","    anno_path = os.path.join(DATA_PATH, f\"{'Bangla' if lang == 'BN' else 'English'} Annotated Files\")\n","\n","    # Load Annotations\n","    if os.path.exists(anno_path):\n","        for file in os.listdir(anno_path):\n","            if file.endswith('.json'):\n","                with open(os.path.join(anno_path, file), 'r', encoding='utf-8') as f:\n","                    meta = parse_filename(file)\n","                    annotations[meta['story']] = {'meta': meta, 'data': json.load(f)}\n","\n","    # Load Retellings\n","    retellings = []\n","    ret_root = os.path.join(DATA_PATH, f\"{'Bangla' if lang == 'BN' else 'English'} Retellings\")\n","\n","    if os.path.exists(ret_root):\n","        for root, dirs, files in os.walk(ret_root):\n","            for file in files:\n","                if file.endswith('.txt'):\n","                    with open(os.path.join(root, file), 'r', encoding='utf-8') as f:\n","                        try:\n","                            retellings.append({\n","                                'meta': parse_filename(file),\n","                                'content': f.read(),\n","                                'path': os.path.join(root, file)\n","                            })\n","                        except Exception as e:\n","                            print(f\"Error reading {file}: {e}\")\n","\n","    return annotations, retellings"],"metadata":{"id":"OdU1Hc6-omju","executionInfo":{"status":"ok","timestamp":1768992828915,"user_tz":-360,"elapsed":24,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["# ==========================================\n","# CORE ALGORITHM: FUZZY SEARCH\n","# ==========================================\n","\n","def check_term_presence(text: str, term: str) -> Dict:\n","    \"\"\"\n","    Checks if a cultural term exists in the text using Fuzzy Logic.\n","    Returns: {found: bool, match: str, score: int}\n","    \"\"\"\n","    # 1. Exact Match Check (Fastest)\n","    if term.lower() in text.lower():\n","        return {'found': True, 'match': term, 'score': 100}\n","\n","    # 2. Token Set Ratio Check (TheFuzz)\n","    # This handles \"Pithe\" vs \"Pitha\" inside a long sentence.\n","    # It compares the term against every word in the text.\n","\n","    # Optimization: Split text into words to avoid scanning entire paragraphs\n","    words = text.replace('.', ' ').replace(',', ' ').split()\n","\n","    best_score = 0\n","    best_match = \"\"\n","\n","    for word in words:\n","        # Optimization: distinct words only, strict length filter\n","        if abs(len(word) - len(term)) > 2: continue\n","\n","        score = fuzz.ratio(term.lower(), word.lower())\n","        if score > best_score:\n","            best_score = score\n","            best_match = word\n","\n","    if best_score >= MATCH_THRESHOLD:\n","        return {'found': True, 'match': best_match, 'score': best_score}\n","\n","    return {'found': False, 'match': None, 'score': best_score}"],"metadata":{"id":"YilxKmZnoq4v","executionInfo":{"status":"ok","timestamp":1768992831957,"user_tz":-360,"elapsed":14,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["# ==========================================\n","# MAIN EXECUTION\n","# ==========================================\n","\n","def main():\n","    LANG = 'EN' # Switch to 'BN' if analyzing Bangla outputs\n","    annotations, retellings = load_data(LANG)\n","\n","    results = []\n","\n","    print(f\"\\n🚀 Starting Lexical Analysis (Design A) on {len(retellings)} stories...\")\n","\n","    for ret in tqdm(retellings):\n","        story_key = ret['meta']['story']\n","\n","        # Fallback matching for filenames\n","        if story_key not in annotations:\n","             for k in annotations.keys():\n","                if story_key in k or k in story_key:\n","                    story_key = k\n","                    break\n","\n","        if story_key not in annotations:\n","            continue\n","\n","        gt_data = annotations[story_key]['data']\n","\n","        # Extract Lexical Terms\n","        lexical_items = gt_data.get('lexical_integrity', [])\n","        if not lexical_items:\n","            continue\n","\n","        # Analyze each term\n","        total_terms = 0\n","        preserved_terms = 0\n","        term_details = []\n","\n","        for item in lexical_items:\n","            term = item['term']\n","            importance = item.get('importance', 'Medium')\n","\n","            # Run Check\n","            check = check_term_presence(ret['content'], term)\n","\n","            if check['found']:\n","                preserved_terms += 1\n","                status = \"PRESERVED\"\n","            else:\n","                status = \"ERASED\"\n","\n","            term_details.append({\n","                'term': term,\n","                'status': status,\n","                'matched_word': check['match'],\n","                'fuzzy_score': check['score']\n","            })\n","            total_terms += 1\n","\n","        # Calculate Score\n","        retention_score = preserved_terms / total_terms if total_terms > 0 else 0.0\n","\n","        results.append({\n","            'story': story_key,\n","            'model': ret['meta']['model'],\n","            'prompt': ret['meta']['prompt'],\n","            'lexical_retention_score': round(retention_score, 3),\n","            'total_terms': total_terms,\n","            'preserved_count': preserved_terms,\n","            'details': term_details\n","        })\n","\n","    # Save Results\n","    # 1. JSON (Deep Dive)\n","    json_path = os.path.join(RESULTS_PATH, f\"design_a_lexical_results_{LANG}.json\")\n","    with open(json_path, 'w') as f:\n","        json.dump(results, f, indent=2, ensure_ascii=False)\n","\n","    # 2. CSV (Summary)\n","    df = pd.DataFrame(results).drop(columns=['details'])\n","    csv_path = os.path.join(RESULTS_PATH, f\"design_a_summary_{LANG}.csv\")\n","    df.to_csv(csv_path, index=False)\n","\n","    print(f\"\\n✅ Done! Results saved to:\\n- {csv_path}\")\n","    print(\"\\nSample Output:\")\n","    print(df.head())\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":396,"referenced_widgets":["3b09394332ee4410a5746b6d6a015bbe","d0524f6a62bc497fb0bdf262819fff26","3c78930b06394d4296553777d0cd2aeb","92adce9f1a1d450fbacced92db6cb015","84ae64fc42614ed8b967e564cf36f4d0","020a5abd3b504bc5bd6b24f5f12e71d0","c96da91ed42d464b8965a0105d39bf7b","b2da60aecdbc4486b7f9174846ae4b44","d65dc3bb8a1c47139bcd1c08fc89ea02","a0a54c11362b4571be46b63371bb44f8","c1e6c58e5613430b9a4640817820d723"]},"id":"Bh45iv_4oujh","executionInfo":{"status":"ok","timestamp":1768993092223,"user_tz":-360,"elapsed":54445,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}},"outputId":"ea403576-46d7-4e0b-c79e-f518a722fbe1"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","🚀 Starting Lexical Analysis (Design A) on 240 stories...\n"]},{"output_type":"display_data","data":{"text/plain":["  0%|          | 0/240 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"3b09394332ee4410a5746b6d6a015bbe"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","✅ Done! Results saved to:\n","- /content/drive/My Drive/Algorithmic Amnesia/Evaluation Results/Design