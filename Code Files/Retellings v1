displayName":"Sidratul Montaha","userId":"04819065037139909156"}},"outputId":"d9365e74-8cf8-4be4-f2ce-7629895ca5f6"},"execution_count":20,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}]},{"cell_type":"code","source":["# ================= 2. HELPER FUNCTIONS (FINAL FIX) =================\n","\n","def load_api_keys():\n","    \"\"\"Reads keys and aggressively scrubs invisible BOM characters.\"\"\"\n","    if not os.path.exists(KEY_FILE):\n","        raise FileNotFoundError(f\"❌ API Key file not found at: {KEY_FILE}\")\n","\n","    # We use utf-8-sig to try to catch it, but we also manually replace it\n","    # just in case it's lurking deeper in the string.\n","    with open(KEY_FILE, 'r', encoding='utf-8-sig') as f:\n","        keys = []\n","        for line in f:\n","            # 1. Remove BOM (\\ufeff) manually if present\n","            # 2. Strip whitespace (newlines/spaces)\n","            clean_key = line.replace('\\ufeff', '').strip()\n","\n","            if clean_key:\n","                keys.append(clean_key)\n","\n","    if not keys:\n","        raise ValueError(\"❌ API Key file is empty!\")\n","\n","    print(f\"✅ Loaded {len(keys)} API keys.\")\n","    return keys\n","\n","def get_stories():\n","    \"\"\"\n","    Scans English and Bangla folders with BOM protection.\n","    \"\"\"\n","    stories = {}\n","\n","    # Scan English\n","    for f_path in glob.glob(os.path.join(INPUT_EN, \"*.txt\")):\n","        filename = os.path.basename(f_path)\n","        try:\n","            parts = filename.rsplit('_', 1)\n","            core_name = parts[0]\n","\n","            if core_name not in stories:\n","                stories[core_name] = {'EN': None, 'BN': None, 'Region': core_name.split('_')[0], 'Name': core_name.split('_')[1]}\n","\n","            # SAFE READ\n","            with open(f_path, 'r', encoding='utf-8-sig') as f:\n","                stories[core_name]['EN'] = f.read().replace('\\ufeff', '')\n","        except Exception as e:\n","            print(f\"⚠️ Skipping {filename}: {e}\")\n","\n","    # Scan Bangla\n","    for f_path in glob.glob(os.path.join(INPUT_BN, \"*.txt\")):\n","        filename = os.path.basename(f_path)\n","        try:\n","            parts = filename.rsplit('_', 1)\n","            core_name = parts[0]\n","\n","            if core_name not in stories:\n","                stories[core_name] = {'EN': None, 'BN': None, 'Region': core_name.split('_')[0], 'Name': core_name.split('_')[1]}\n","\n","            # SAFE READ\n","            with open(f_path, 'r', encoding='utf-8-sig') as f:\n","                stories[core_name]['BN'] = f.read().replace('\\ufeff', '')\n","        except Exception as e:\n","            print(f\"⚠️ Skipping {filename}: {e}\")\n","\n","    valid = {k:v for k,v in stories.items() if v['EN'] or v['BN']}\n","    print(f\"✅ Found {len(valid)} stories.\")\n","    return valid"],"metadata":{"id":"7MRqfPXYFHBv","executionInfo":{"status":"ok","timestamp":1768580428517,"user_tz":-360,"elapsed":4,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}}},"execution_count":21,"outputs":[]},{"cell_type":"code","source":["# ================= 3. ENGINE =================\n","\n","def run_experiment():\n","    keys = load_api_keys()\n","    key_index = 0\n","    client = OpenAI(base_url=\"https://openrouter.ai/api/v1\", api_key=keys[key_index])\n","\n","    stories = get_stories()\n","\n","    # Calculate Total Operations for Progress Bar\n","    # Stories * Languages (2) * Models * Prompts (4)\n","    total_ops = len(stories) * 2 * len(MODELS) * 4\n","    pbar = tqdm(total=total_ops, desc=\"Generating Retellings\", unit=\"req\")\n","\n","    for story_key, data in stories.items():\n","        story_name = data['Name']\n","        region = data['Region']\n","\n","        for lang in [\"English\", \"Bangla\"]:\n","\n","            # Define Output Base Folder (English Retellings / Bangla Retellings)\n","            lang_folder_name = f\"{lang} Retellings\"\n","\n","            for model_slug, model_folder_name in MODELS.items():\n","                for p_id, p_folder_name in PROMPT_NAMES.items():\n","\n","                    # --- 1. DEFINE PATH ---\n","                    # Format: P2's 10 > [Lang] Retellings > [Model] > [Prompt] > [Story].txt\n","                    target_dir = os.path.join(BASE_DIR, lang_folder_name, model_folder_name, p_folder_name)\n","                    os.makedirs(target_dir, exist_ok=True)\n","\n","                    filename = f\"{story_key}_{lang}.txt\" # e.g. thakurmar_panta_buri_Bangla.txt\n","                    file_path = os.path.join(target_dir, filename)\n","\n","                    # --- 2. CHECK IF EXISTS ---\n","                    if os.path.exists(file_path):\n","                        # Update progress bar and skip\n","                        pbar.update(1)\n","                        continue\n","\n","                    # --- 3. BUILD PROMPT ---\n","                    prompt_text = \"\"\n","                    if lang == \"English\":\n","                        if p_id == 1: prompt_text = f\"Retell the Bengali folktale of '{story_name}'.\"\n","                        elif p_id == 2: prompt_text = f\"Retell the Bengali folktale of '{story_name}' from {region}. Preserve original cultural nuances, kinship terms, and specific rituals.\"\n","                        elif p_id == 3: prompt_text = f\"Retell the Bengali folktale of '{story_name}' in under 250 words, focusing on its morals or lessons.\"\n","                        elif p_id == 4: prompt_text = f\"Read the following source text carefully and retell the story based ONLY on this text:\\n\\nSOURCE:\\n{data['EN']}\"\n","                    else: # Bangla\n","                        if p_id == 1: prompt_text = f\"'{story_name}' এর বাংলা লোককথাটি বলো।\"\n","                        elif p_id == 2: prompt_text = f\"'{region}' এর প্রেক্ষাপটে '{story_name}' গল্পটি বলো। গল্পের মূল সাংস্কৃতিক অনুষঙ্গ, আত্মীয়তার ডাক এবং নির্দিষ্ট আচার-অনুষ্ঠানগুলো হুবহু বজায় রাখবে।\"\n","                        elif p_id == 3: prompt_text = f\"'{story_name}' গল্পটি ২৫০ শব্দের মধ্যে বলো, বিশেষ করে এর নীতিকথা বা শিক্ষার ওপর ফোকাস করো।\"\n","                        elif p_id == 4: prompt_text = f\"নিচের গল্পটি পড়ো এবং শুধুমাত্র এই টেক্সটের ওপর ভিত্তি করে গল্পটি নিজের ভাষায় লেখো:\\n\\nSOURCE:\\n{data['BN']}\"\n","\n","                    # Skip if source text is missing for Prompt 4\n","                    if p_id == 4 and ((lang == \"English\" and not data['EN']) or (lang == \"Bangla\" and not data['BN'])):\n","                         pbar.write(f\"⚠️ Missing source text for {story_name} ({lang}). Skipping P4.\")\n","                         pbar.update(1)\n","                         continue\n","\n","                    # --- 4. API CALL LOOP ---\n","                    success = False\n","                    retries = 0\n","\n","                    while not success and retries < 3:\n","                        try:\n","                            completion = client.chat.completions.create(\n","                                model=model_slug,\n","                                messages=[{\"role\": \"user\", \"content\": prompt_text}],\n","                                extra_headers={\"HTTP-Referer\": \"research-study\"}\n","                            )\n","                            output_content = completion.choices[0].message.content\n","\n","                            # Write to File\n","                            with open(file_path, \"w\", encoding=\"utf-8\") as f:\n","                                f.write(output_content)\n","\n","                            success = True\n","                            pbar.update(1)\n","\n","                        except Exception as e:\n","                            err_msg = str(e)\n","                            # Check for 429 (Rate Limit) or 402 (Payment/Credits)\n","                            if \"429\" in err_msg or \"402\" in err_msg or \"quota\" in err_msg.lower():\n","                                pbar.write(f\"🛑 Key Exhausted/Rate Limit on Key #{key_index+1}. Switching...\")\n","\n","                                # Switch Key\n","                                if key_index < len(keys) - 1:\n","                                    key_index += 1\n","                                    client = OpenAI(base_url=\"https://openrouter.ai/api/v1\", api_key=keys[key_index])\n","                                    pbar.write(f\"✅ Switched to Key #{key_index+1}. Retrying...\")\n","                                    time.sleep(2) # Brief pause\n","                                else:\n","                                    pbar.write(\"❌ ALL KEYS EXHAUSTED. Waiting 60 seconds...\")\n","                                    time.sleep(60)\n","                                    # Optional: Reset to key 0 if you think it's just a temporary rate limit\n","                                    # key_index = 0\n","                            else:\n","                                pbar.write(f\"⚠️ Error on {story_name}/{model_folder_name}: {e}\")\n","                                retries += 1\n","                                time.sleep(5)\n","\n","    print(\"\\n🎉 Experiment Complete! Check your 'Retellings' folders.\")\n","\n","if __name__ == \"__main__\":\n","    run_experiment()"],"metadata":{"id":"6a4wZH_pFMse","executionInfo":{"status":"ok","timestamp":1768580432143,"user_tz":-360,"elapsed":60,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}}},"execution_count":22,"outputs":[]}]}