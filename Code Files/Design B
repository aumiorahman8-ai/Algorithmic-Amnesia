"1.2.0","_view_name":"StyleView","description_width":""}}}}},"cells":[{"cell_type":"markdown","source":["Design Solution B: Structural Integrity & Distortion Mapping\n","(Improved Semantic Analysis with Westernization Triangulation)\n","\n","Objectives:\n","1. Narrative Fidelity: Can we find the atomic plot points ANYWHERE in the text?\n","2. Distortion Mapping: Are the events in the correct chronological order?\n","3. Westernization Risk: Does the text align closer to Western concepts than Bengali ones?"],"metadata":{"id":"BD9Mff4TcMOz"}},{"cell_type":"code","source":["import os\n","import json\n","import re\n","import numpy as np\n","import pandas as pd\n","from typing import Dict, List, Tuple\n","from sentence_transformers import SentenceTransformer, util\n","from scipy.stats import spearmanr\n","from tqdm.auto import tqdm"],"metadata":{"id":"dDI9lqQucRCI","executionInfo":{"status":"ok","timestamp":1768992097917,"user_tz":-360,"elapsed":6,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}}},"execution_count":16,"outputs":[]},{"cell_type":"code","source":["from google.colab import drive\n","\n","# Mount Google Drive\n","if not os.path.exists('/content/drive'):\n","    drive.mount('/content/drive', force_remount = True)"],"metadata":{"id":"PZYrmIDpcUVp","executionInfo":{"status":"ok","timestamp":1768992099658,"user_tz":-360,"elapsed":21,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}}},"execution_count":17,"outputs":[]},{"cell_type":"code","source":["# ==========================================\n","# CONFIGURATION\n","# ==========================================\n","BASE_PATH = \"/content/drive/My Drive/Algorithmic Amnesia/Text Corpus\"\n","DATA_PATH = os.path.join(BASE_PATH, \"P2's 10\")\n","RESULTS_PATH = \"/content/drive/My Drive/Algorithmic Amnesia/Evaluation Results/Design_B_Results\"\n","os.makedirs(RESULTS_PATH, exist_ok=True)\n","\n","# Load Model (Optimized for Semantic Search)\n","# 'all-MiniLM-L6-v2' is fast and effective for this.\n","# For higher accuracy, use 'all-mpnet-base-v2' (slower but smarter).\n","MODEL_NAME = 'paraphrase-multilingual-MiniLM-L12-v2'\n","print(f\"⏳ Loading Embedding Model: {MODEL_NAME}...\")\n","model = SentenceTransformer(MODEL_NAME)\n","print(\"✅ Model Loaded.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"5IVN-c2Gc1k5","executionInfo":{"status":"ok","timestamp":1768992105758,"user_tz":-360,"elapsed":4620,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}},"outputId":"1f4325a8-bc72-4374-d4c4-4ae7f5ce8e5e"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["⏳ Loading Embedding Model: paraphrase-multilingual-MiniLM-L12-v2...\n","✅ Model Loaded.\n"]}]},{"cell_type":"code","source":["# ==========================================\n","# UTILITIES\n","# ==========================================\n","\n","def parse_filename(filename: str) -> Dict:\n","    \"\"\"Extract metadata from standardized filenames.\"\"\"\n","    clean_name = filename.replace('.txt', '').replace('.json', '')\n","    parts = clean_name.split('_')\n","\n","    if filename.endswith('.txt'):\n","        # Handling inconsistent naming if necessary\n","        return {\n","            'type': 'retelling',\n","            'story': '_'.join(parts[:-3]), # Adjust based on your actual filenames\n","            'language': parts[-3],\n","            'prompt': parts[-2],\n","            'model': parts[-1],\n","            'filename': filename\n","        }\n","    else:\n","        return {\n","            'type': 'annotation',\n","            'story': '_'.join(parts[:-1]),\n","            'language': parts[-1],\n","            'filename': filename\n","        }\n","\n","def load_data(lang: str) -> Tuple[Dict, List[Dict]]:\n","    annotations = {}\n","    anno_path = os.path.join(DATA_PATH, f\"{'Bangla' if lang == 'BN' else 'English'} Annotated Files\")\n","\n","    if not os.path.exists(anno_path):\n","        print(f\"❌ Error: Path not found: {anno_path}\")\n","        return {}, []\n","\n","    # Load Annotations\n","    for file in os.listdir(anno_path):\n","        if file.endswith('.json'):\n","            with open(os.path.join(anno_path, file), 'r', encoding='utf-8') as f:\n","                meta = parse_filename(file)\n","                annotations[meta['story']] = {'meta': meta, 'data': json.load(f)}\n","\n","    # Load Retellings\n","    retellings = []\n","    ret_root = os.path.join(DATA_PATH, f\"{'Bangla' if lang == 'BN' else 'English'} Retellings\")\n","\n","    if not os.path.exists(ret_root):\n","        print(f\"❌ Error: Path not found: {ret_root}\")\n","        return {}, []\n","\n","    for root, dirs, files in os.walk(ret_root):\n","        for file in files:\n","            if file.endswith('.txt'):\n","                filepath = os.path.join(root, file)\n","                with open(filepath, 'r', encoding='utf-8') as f:\n","                    try:\n","                        retellings.append({\n","                            'meta': parse_filename(file),\n","                            'content': f.read(),\n","                            'path': filepath\n","                        })\n","                    except Exception as e:\n","                        print(f\"Error reading {file}: {e}\")\n","\n","    print(f\"✅ Loaded {len(annotations)} Annotations and {len(retellings)} Retellings.\")\n","    return annotations, retellings\n","\n","def get_plot_points(gt_data: Dict) -> List[str]:\n","    \"\"\"Smart extractor to find plot points regardless of JSON structure.\"\"\"\n","    # Priority 1: Nested in narrative_cohesion (Your current structure)\n","    if 'narrative_cohesion' in gt_data and 'atomic_plot_nodes' in gt_data['narrative_cohesion']:\n","        return gt_data['narrative_cohesion']['atomic_plot_nodes']\n","\n","    # Priority 2: Top level (Alternative structure)\n","    if 'atomic_plot_points' in gt_data:\n","        return gt_data['atomic_plot_points']\n","\n","    # Priority 3: Check for 'atomic_plot_nodes' at top level\n","    if 'atomic_plot_nodes' in gt_data:\n","        return gt_data['atomic_plot_nodes']\n","\n","    return []"],"metadata":{"id":"keOBVjW4c5PM","executionInfo":{"status":"ok","timestamp":1768992109137,"user_tz":-360,"elapsed":31,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}}},"execution_count":19,"outputs":[]},{"cell_type":"code","source":["# ==========================================\n","# CORE ALGORITHM: SEMANTIC NEEDLE SEARCH\n","# ==========================================\n","\n","def split_into_sentences(text: str) -> List[str]:\n","    sentences = re.split(r'[.|?!।]+', text)\n","    return [s.strip() for s in sentences if len(s.strip()) > 10]\n","\n","def analyze_narrative_fidelity(retelling_text: str, plot_points: List[str]) -> Dict:\n","    sentences = split_into_sentences(retelling_text)\n","    if not sentences:\n","        return {'score': 0.0, 'matches': [], 'chronology_score': 0.0}\n","\n","    haystack_embeddings = model.encode(sentences, convert_to_tensor=True)\n","    needle_embeddings = model.encode(plot_points, convert_to_tensor=True)\n","\n","    matches = []\n","    found_indices = []\n","\n","    cosine_scores = util.cos_sim(needle_embeddings, haystack_embeddings)\n","\n","    for i, point in enumerate(plot_points):\n","        best_score_idx = np.argmax(cosine_scores[i].cpu().numpy())\n","        best_score = cosine_scores[i][best_score_idx].item()\n","\n","        matches.append({\n","            'plot_point': point,\n","            'best_match_sentence': sentences[best_score_idx],\n","            'similarity_score': float(best_score),\n","            'sentence_index': int(best_score_idx)\n","        })\n","\n","        if best_score > 0.45: # Threshold for \"Found\"\n","            found_indices.append(int(best_score_idx))\n","\n","    avg_similarity = sum([m['similarity_score'] for m in matches]) / len(matches) if matches else 0\n","\n","    if len(found_indices) > 2:\n","        chronology_score, _ = spearmanr(range(len(found_indices)), sorted(found_indices))\n","        if pd.isna(chronology_score): chronology_score = 0.0\n","    else:\n","        chronology_score = 0.0\n","\n","    return {\n","        'fidelity_score': avg_similarity,\n","        'chronology_score': chronology_score,\n","        'matches': matches\n","    }"],"metadata":{"id":"0bbXq_3Oc8hP","executionInfo":{"status":"ok","timestamp":1768992113392,"user_tz":-360,"elapsed":25,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}}},"execution_count":20,"outputs":[]},{"cell_type":"code","execution_count":21,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":466,"referenced_widgets":["3393da2b2d7e4774aa6f953909749416","26fe2648cea64849940b6c477d3afa0f","84ddd65b4c90475dbb12a99acea71e5f","5ef9aa2025ef43ffb8a6babf603eb976","2c3c07b3e2a2489d8f197e76010f28d5","0e60b8430d4a41b59615d4fe33cc558d","c21ef3fa73bb49e3b9cb148fad076cea","75c951d6d4d84bd7998f0cb79ed96029","dde6d9624d2a4c6eb174c43698f448e6","34cab522d88347659e34b637aa924b51","a52cdcd41292473db3f28c504b1e4965"]},"id":"dPchkViPbAFW","executionInfo":{"status":"ok","timestamp":1768992684167,"user_tz":-360,"elapsed":567818,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}},"outputId":"0f35ba8b-45bd-49ab-f3ec-2e27d0ad413e"},"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Loaded 10 Annotations and 240 Retellings.\n","\n","🚀 Starting Semantic Analysis on 240 stories...\n","\n"]},{"output_type":"display_data","data":{"text/plain":["  0%|          | 0/240 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"3393da2b2d7e4774aa6f953909749416"}},"metadata":{}},{"output_type":"stream","name":"stderr","text":["/tmp/ipython-input-3854548489.py:39: ConstantInputWarning: An input array is constant; the correlation coefficient is not defined.\n","  chronology_score, _ = spearmanr(range(len(found_indices)), sorted(found_indices))\n"]},{"output_type":"stream","name":"stdout","text":["\n","✅ Success! Results saved to:\n","- /content/drive/My Drive/Algorithmic Amnesia/Evaluation Results/Design_B_Results/design_b_summary_EN.csv\n","\n","Sample Output:\n","                                               story  model prompt  \\\n","0      cox's bazar_marriage with the prince of snake  Llama      1   \n","1        jessore_the consequence of a broken promise  Llama      1   \n","2   joypurhut_morar shakkhi (witness of the bubbles)  Llama      1   \n","3  moulovibazar_Fifteen Sizzles, Three to Eat, Th...  Llama      1   \n","4                                  rangamati_khumpui  Llama      1   \n","\n","   narrative_fidelity  chronology_score  \n","0               0.501             0.866  \n","1               0.375             1.000  \n","2               0.400             1.000  \n","3               0.377             0.000  \n","4               0.475             0.964  \n"]}],"source":["def main():\n","    # SET LANGUAGE HERE\n","    LANG = 'EN'  # Change to 'BN' if needed\n","\n","    annotations, retellings = load_data(LANG)\n","    results = []\n","\n","    print(f\"\\n🚀 Starting Semantic Analysis on {len(retellings)} stories...\\n\")\n","\n","    for ret in tqdm(retellings):\n","        story_key = ret['meta']['story']\n","\n","        # Try to match fuzzy filenames if exact match fails\n","        if story_key not in annotations:\n","            # Simple fallback: check if story_key is a substring of an annotation key\n","            found = False\n","            for k in annotations.keys():\n","                if story_key in k or k in story_key:\n","                    story_key = k\n","                    found = True\n","                    break\n","            if not found:\n","                continue\n","\n","        gt_data = annotations[story_key]['data']\n","        plot_points = get_plot_points(gt_data)\n","\n","        if not plot_points:\n","            # Only print warning once per story key to avoid spam\n","            # print(f\"⚠ Warning: No plot points found for {story_key}\")\n","            continue\n","\n","        analysis = analyze_narrative_fidelity(ret['content'], plot_points)\n","\n","        result = {\n","            'story': story_key,\n","            'model': ret['meta']['model'],\n","            'prompt': ret['meta']['prompt'],\n","            'narrative_fidelity': round(analysis['fidelity_score'], 3),\n","            'chronology_score': round(analysis['chronology_score'], 3),\n","            'details': analysis['matches']\n","        }\n","        results.append(result)\n","\n","    if not results:\n","        print(\"\\n❌ CRITICAL: No results were generated.\")\n","        print(\"Please check:\\n1. Do your JSON files actually have 'atomic_plot_nodes'?\\n2. Do your text filenames match the JSON filenames?\")\n","        return\n","\n","    # Save Results\n","    json_path = os.path.join(RESULTS_PATH, f\"design_b_semantic_results_{LANG}.json\")\n","    with open(json_path, 'w') as f:\n","        json.dump(results, f, indent=2, ensure_ascii=False)\n","\n","    df = pd.DataFrame(results).drop(columns=['details'])\n","    csv_path = os.path.join(RESULTS_PATH, f\"design_b_summary_{LANG}.csv\")\n","    df.to_csv(csv_path, index=False)\n","\n","    print(f\"\\n✅ Success! Results saved to:\\n- {csv_path}\")\n","    print(\"\\nSample Output:\")\n","    print(df.head())\n","\n","if __name__ == \"__main__\":\n","    main()"]},{"cell_type":"markdown","source":["Chunks the LLM's generated story into individual sentences.\n","\n","Embeds both the Ground Truth \"Atomic Plot Points\" and the story sentences using sentence-transformers.\n","\n","Hunts for each plot point within the story (the \"Needle in a Haystack\" search).\n","\n","Outputs a JSON report with a narrative_fidelity_score and chronology_score."],"metadata":{"id":"a6JL5C_5hPJY"}}]}