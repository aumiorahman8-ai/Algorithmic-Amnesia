() method.**\n","10. Saves the translated text into a new file with an '_EN.txt' suffix.\n","11. Includes error handling and a final summary.\n","\"\"\"\n","\n","# --- 1. Install Dependencies ---\n","print(\"Installing required libraries: transformers, torch, sentencepiece, nltk, datasets...\")\n","# Added 'datasets' and 'accelerate' for potential model/data handling\n","!pip install transformers[sentencepiece] torch nltk datasets accelerate -q\n","print(\"Libraries installed successfully.\")\n","print(\"-\" * 30)\n","\n","import os\n","import sys\n","import torch\n","from transformers import AutoModelForSeq2SeqLM, AutoTokenizer\n","from google.colab import drive\n","import nltk\n","\n","# Download the NLTK data for sentence tokenization\n","try:\n","    nltk.download('punkt', quiet=True)\n","    # The 'punkt_tab' package is not a standard NLTK download. Removed the extra line.\n","    print(\"NLTK 'punkt' tokenizer downloaded.\")\n","except Exception as e:\n","    print(f\"Warning: Could not download NLTK tokenizers. Will try to proceed. Error: {e}\")\n","\n","# --- 2. Mount Google Drive ---\n","print(\"Mounting Google Drive...\")\n","try:\n","    # Use 'drive.mount' without force_remount unless absolutely necessary\n","    drive.mount('/content/drive')\n","    print(\"Google Drive mounted successfully.\")\n","except Exception as e:\n","    print(f\"An error occurred while mounting Google Drive: {e}\")\n","    sys.exit(\"Script stopped due to Drive mounting failure.\")\n","print(\"-\" * 30)\n","\n","\n","# --- 3. Load Hugging Face Translation Model (The Fix) ---\n","MODEL_NAME = \"csebuetnlp/banglat5_nmt_bn_en\"\n","print(f\"Loading Hugging Face translation model: {MODEL_NAME}...\")\n","\n","# Check if a GPU is available and set the device.\n","DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","# Using the standard T5 device mapping\n","DEVICE_ID = 0 if DEVICE == \"cuda\" else -1\n","\n","try:\n","    # Load the Tokenizer first\n","    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n","\n","    # Load the Model using AutoModelForSeq2SeqLM, which is correct for T5 models\n","    model = AutoModelForSeq2SeqLM.from_pretrained(MODEL_NAME).to(DEVICE)\n","\n","    print(f\"Model loaded successfully on device: {DEVICE}\")\n","except Exception as e:\n","    print(f\"Failed to load the Hugging Face model: {e}\")\n","    # Print the model size and hardware info to help debug large model loading failures\n","    print(\"HINT: This model is larger and may require more memory (GPU/High-RAM Colab).\")\n","    sys.exit(\"Script stopped. Could not initialize the translator.\")\n","print(\"-\" * 30)\n","\n","\n","# --- 4. Set up File Paths ---\n","# !!! IMPORTANT: Please verify this path is correct in your Drive !!!\n","base_path = '/content/drive/MyDrive/Algorithmic Amnesia/Text Corpus/'\n","source_folder = os.path.join(base_path, 'Cleaned Bangla Stories')\n","destination_folder = os.path.join(base_path, 'Translations (BanglaT5)')\n","\n","print(f\"Source folder:      {source_folder}\")\n","print(f\"Destination folder: {destination_folder}\")\n","\n","\n","# --- 5. Verify Source and Create Destination Directories ---\n","# Check if the source directory exists.\n","if not os.path.isdir(source_folder):\n","    print(f\"\\nError: Source folder not found at '{source_folder}'\")\n","    sys.exit(\"Please check your folder structure and try again.\")\n","else:\n","    print(\"Source folder found.\")\n","\n","# Create the destination directory if it doesn't exist.\n","try:\n","    os.makedirs(destination_folder, exist_ok=True)\n","    print(f\"Destination folder is ready.\")\n","except OSError as e:\n","    print(f\"Error creating destination folder '{destination_folder}': {e}\")\n","    sys.exit(\"Script stopped due to a filesystem error.\")\n","print(\"-\" * 30)\n","\n","\n","# --- 6. Process and Translate Files ---\n","print(\"\\nStarting the translation process...\")\n","processed_files = 0\n","skipped_files = 0\n","failed_files = 0\n","BATCH_SIZE = 8 # T5 models are better run in batches for speed and efficiency\n","\n","# Get a list of all files in the source directory\n","try:\n","    all_files = os.listdir(source_folder)\n","    # Filter to only get the files we need\n","    files_to_process = [f for f in all_files if f.endswith('_BN.txt')]\n","\n","    if not files_to_process:\n","        print(\"Warning: No files ending with '_BN.txt' were found in the source folder.\")\n","except FileNotFoundError:\n","    print(f\"Critical Error: Could not list files in '{source_folder}'.\")\n","    sys.exit(\"Script stopped.\")\n","\n","\n","for filename in files_to_process:\n","    source_filepath = os.path.join(source_folder, filename)\n","\n","    # Create the corresponding English filename\n","    english_filename = filename.replace('_BN.txt', '_EN.txt')\n","    destination_filepath = os.path.join(destination_folder, english_filename)\n","\n","    print(f\"\\nProcessing '{filename}'...\")\n","\n","    try:\n","        # Read the content of the Bengali file\n","        # Use 'utf-8-sig' to handle Byte Order Mark (BOM) often found in Windows-created text files\n","        with open(source_filepath, 'r', encoding='utf-8-sig') as f:\n","            bengali_text = f.read()\n","\n","        if not bengali_text.strip():\n","            print(f\" -> WARNING: File is empty. Skipping.\")\n","            skipped_files += 1\n","            continue\n","\n","        # --- Translate the text ---\n","        # 1. Split the text into sentences\n","        sentences = nltk.sent_tokenize(bengali_text)\n","        sentences_to_translate = [s.strip() for s in sentences if s.strip()]\n","\n","        if not sentences_to_translate:\n","            print(f\" -> WARNING: File contains no translatable text. Skipping.\")\n","            skipped_files += 1\n","            continue\n","\n","        all_translated_sentences = []\n","\n","        # 2. Process sentences in batches for efficiency\n","        for i in range(0, len(sentences_to_translate), BATCH_SIZE):\n","            batch = sentences_to_translate[i:i + BATCH_SIZE]\n","\n","            # Tokenize the batch and move to the appropriate device\n","            input_ids = tokenizer(\n","                batch,\n","                return_tensors=\"pt\",\n","                padding=True,\n","                truncation=True,\n","                max_length=512\n","            ).input_ids.to(DEVICE)\n","\n","            # Generate the translation\n","            translated_tokens = model.generate(\n","                input_ids,\n","                max_length=512,\n","                # These decoding parameters help improve fluency for T5 models\n","                num_beams=4,\n","                length_penalty=2.0,\n","                early_stopping=True\n","            )\n","\n","            # Decode the translated tokens back to text\n","            translated_sentences = tokenizer.batch_decode(\n","                translated_tokens,\n","                skip_special_tokens=True\n","            )\n","            all_translated_sentences.extend(translated_sentences)\n","\n","        # 3. Join the translated sentences back together\n","        english_text = \"\\n\".join(all_translated_sentences)\n","\n","        # Save the translated text to the new file\n","        with open(destination_filepath, 'w', encoding='utf-8') as f:\n","            f.write(english_text)\n","\n","        print(f\" -> SUCCESS: Translated {len(all_translated_sentences)} sentences and saved to '{english_filename}'\")\n","        processed_files += 1\n","\n","    except FileNotFoundError:\n","        print(f\" -> ERROR: Could not find '{filename}' during processing.\")\n","        failed_files += 1\n","    except Exception as e:\n","        # This will catch errors from the model or file writing\n","        print(f\" -> ERROR: An unexpected error occurred on file '{filename}': {e}\")\n","        failed_files += 1\n","\n","\n","print(\"\\n---------------