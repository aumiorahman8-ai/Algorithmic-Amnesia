out=10\n","            )\n","\n","            if response.status_code == 200:\n","                data = response.json()['data']\n","                usage = data.get('usage', 0)\n","                limit = data.get('limit')\n","\n","                # Format the limit/remaining info\n","                if limit is None:\n","                    limit_str = \"No Limit (Pay-as-you-go)\"\n","                else:\n","                    remaining = limit - usage\n","                    if remaining < 0: remaining = 0\n","                    limit_str = f\"Limit: ${limit:.2f} (Left: ${remaining:.2f})\"\n","\n","                print(f\"{masked_key} | ✅ Active  | ${usage:<11.4f} | {limit_str}\")\n","\n","            elif response.status_code == 401:\n","                print(f\"{masked_key} | ❌ Invalid | {'-':<12} | Key rejected (Check typos)\")\n","            else:\n","                print(f\"{masked_key} | ⚠️ Error   | {'-':<12} | Status: {response.status_code}\")\n","\n","        except Exception as e:\n","             print(f\"{masked_key} | ⚠️ Failed  | {'-':<12} | Connection error\")\n","\n","    print(\"\\n\" + \"-\" * 75)\n","    print(\"DONE.\")\n","\n","if __name__ == \"__main__\":\n","    check_keys()"]}],"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPZyhMhB55ZfKgayJL7mGzV"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"},"widgets":{"application/vnd.jupyter.widget-state+json":{"48437f54d53148dd9f83ea49bcd468de":{"model_module":"@jupyter-widgets/controls","model_name":"HBoxModel","model_module_version":"1.5.0","state":{"_dom_classes":[],"_model_module":"@jupyter-widgets/controls","_model_module_version":"1.5.0","_model_name":"HBoxModel","_view_count":null,"_view_module":"@jupyter-widgets/controls","_view_module_version":"1.5.0","_view_name":"HBoxView","box_style":"","children":["IPY_MODEL_893d1f8c09194596b4a5b427d3a3c1b0","IPY_MODEL_33c3bcf345584ed09df278e2268f0262","IPY_MODEL_bb6354d27f554e1690853dd360