SOURCE:\\n{data['EN']}\"\n","                    else:\n","                        if p_id == 1:\n","                            prompt_text = f\"'{story_name}' এর বাংলা লোককথাটি বলো।\"\n","                        elif p_id == 2:\n","                            prompt_text = f\"'{region}' এর প্রেক্ষাপটে '{story_name}' গল্পটি বলো। গল্পের মূল সাংস্কৃতিক অনুষঙ্গ, আত্মীয়তার ডাক এবং নির্দিষ্ট আচার-অনুষ্ঠানগুলো হুবহু বজায় রাখবে।\"\n","                        elif p_id == 3:\n","                            prompt_text = f\"'{story_name}' গল্পটি ২৫০ শব্দের মধ্যে বলো, বিশেষ করে এর নীতিকথা বা শিক্ষার ওপর ফোকাস করো।\"\n","                        elif p_id == 4:\n","                            prompt_text = f\"নিচের গল্পটি পড়ো এবং শুধুমাত্র এই টেক্সটের ওপর ভিত্তি করে গল্পটি নিজের ভাষায় লেখো:\\n\\nSOURCE:\\n{data['BN']}\"\n","\n","                    # Skip if source missing for P4\n","                    if p_id == 4 and ((lang == \"English\" and not data['EN']) or (lang == \"Bangla\" and not data['BN'])):\n","                         pbar.write(f\"⚠️ Missing source for {story_name} ({lang}). Skipping P4.\")\n","                         pbar.update(1)\n","                         continue\n","\n","                    # --- 4. API CALL WITH ROBUST ERROR HANDLING ---\n","                    success = False\n","                    retries = 0\n","                    max_retries = 3\n","\n","                    while not success and retries < max_retries:\n","                        try:\n","                            completion = client.chat.completions.create(\n","                                model=model_slug,\n","                                messages=[{\"role\": \"user\", \"content\": prompt_text}],\n","                                extra_headers={\"HTTP-Referer\": \"research-study\"}\n","                            )\n","                            output_content = completion.choices[0].message.content\n","\n","                            with open(file_path, \"w\", encoding=\"utf-8\") as f:\n","                                f.write(output_content)\n","\n","                            success = True\n","                            pbar.update(1)\n","                            time.sleep(1)  # Rate limiting courtesy\n","\n","                        except Exception as e:\n","                            err_msg = str(e).lower()\n","\n","                            # Handle 404 (Model not found)\n","                            if \"404\" in err_msg or \"not found\" in err_msg:\n","                                pbar.write(f\"❌ Model '{model_slug}' not found (404). Skipping this model.\")\n","                                failed_requests.append(f\"{story_name}/{model_folder_name}/P{p_id}: 404 Error\")\n","                                break  # Skip to next model\n","\n","                            # Handle rate limits / quota\n","                            elif \"429\" in err_msg or \"402\" in err_msg or \"quota\" in err_msg or \"rate limit\" in err_msg:\n","                                pbar.write(f\"🛑 Rate limit on Key #{key_index+1}\")\n","\n","                                if key_index < len(keys) - 1:\n","                                    key_index += 1\n","                                    client = OpenAI(\n","                                        base_url=\"https://openrouter.ai/api/v1\",\n","                                        api_key=keys[key_index],\n","                                        timeout=120.0\n","                                    )\n","                                    pbar.write(f\"✅ Switched to Key #{key_index+1}\")\n","                                    time.sleep(3)\n","                                else:\n","                                    pbar.write(\"❌ All keys exhausted. Waiting 60s...\")\n","                                    time.sleep(60)\n","                                    key_index = 0  # Reset to first key\n","                                    client = OpenAI(\n","                                        base_url=\"https://openrouter.ai/api/v1\",\n","                                        api_key=keys[key_index],\n","                                        timeout=120.0\n","                                    )\n","\n","                            # Handle timeout\n","                            elif \"timeout\" in err_msg:\n","                                pbar.write(f\"⏱️ Timeout on {story_name}/{model_folder_name}. Retry {retries+1}/{max_retries}\")\n","                                retries += 1\n","                                time.sleep(5)\n","\n","                            # Other errors\n","                            else:\n","                                pbar.write(f\"⚠️ Error: {e}\")\n","                                retries += 1\n","                                time.sleep(5)\n","\n","                        # If we've exhausted retries\n","                        if retries >= max_retries and not success:\n","                            pbar.write(f\"❌ Failed after {max_retries} retries: {story_name}/{model_folder_name}/P{p_id}\")\n","                            failed_requests.append(f\"{story_name}/{model_folder_name}/P{p_id}: Max retries\")\n","                            pbar.update(1)\n","                            break\n","\n","    pbar.close()\n","\n","    print(\"\\n\" + \"=\"*60)\n","    print(\"🎉 Experiment Complete!\")\n","    print(\"=\"*60)\n","\n","    if failed_requests:\n","        print(f\"\\n⚠️ {len(failed_requests)} requests failed:\")\n","        for fail in failed_requests[:20]:  # Show first 20\n","            print(f\"   - {fail}\")\n","        if len(failed_requests) > 20:\n","            print(f\"   ... and {len(failed_requests)-20} more\")\n","    else:\n","        print(\"\\n✅ All requests completed successfully!\")\n","\n","if __name__ == \"__main__\":\n","    run_experiment()"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"