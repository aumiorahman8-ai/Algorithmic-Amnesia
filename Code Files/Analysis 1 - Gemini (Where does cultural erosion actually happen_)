--------------------------------------------------\n","# 1. SETUP AND MOUNT DRIVE\n","# ---------------------------------------------------------\n","print(\"Mounting Google Drive...\")\n","drive.mount('/content/drive')\n","\n","# Define the path\n","base_path = '/content/drive/My Drive/Algorithmic Amnesia/Evaluation Results/Design_C_Results'\n","\n","# File names\n","file_en = 'SUMMARY_EVAL_EN_20260119_173104.csv'\n","file_bn = 'SUMMARY_EVAL_BN_20260119_193511.csv'\n","\n","# Full paths\n","path_en = os.path.join(base_path, file_en)\n","path_bn = os.path.join(base_path, file_bn)\n","\n","# ---------------------------------------------------------\n","# 2. DATA LOADING AND PREPROCESSING\n","# ---------------------------------------------------------\n","def load_and_prep_data(file_path, language_label):\n","    if not os.path.exists(file_path):\n","        print(f\"Error: File not found at {file_path}\")\n","        return None\n","\n","    df = pd.read_csv(file_path)\n","\n","    # Ensure columns exist\n","    required_cols = ['Lexical_Score', 'Narrative_Score', 'Cultural_Score']\n","    if not all(col in df.columns for col in required_cols):\n","        print(f\"Error: Missing columns in {language_label} file.\")\n","        return None\n","\n","    # --- NORMALIZE CULTURAL SCORE (0-1) ---\n","    # We use Min-Max scaling. If all scores are equal, it defaults to 0.5 or 0.\n","    c_min = df['Cultural_Score'].min()\n","    c_max = df['Cultural_Score'].max()\n","\n","    # Avoid division by zero if all scores are identical\n","    if c_max - c_min != 0:\n","        df['Cultural_Score_Norm'] = (df['Cultural_Score'] - c_min) / (c_max - c_min)\n","    else:\n","        df['Cultural_Score_Norm'] = df['Cultural_Score'] # Keep original if range is 0\n","\n","    # Add language tag for the combined plot\n","    df['Language'] = language_label\n","\n","    return df\n","\n","print(\"Loading data...\")\n","df_en = load_and_prep_data(path_en, 'English')\n","df_bn = load_and_prep_data(path_bn, 'Bangla')\n","\n","if df_en is not None and df_bn is not None:\n","\n","    # Combine datasets for the third plot\n","    df_combined = pd.concat([df_en, df_bn], ignore_index=True)\n","\n","    # Reshape data for plotting (Melting)\n","    # We want rows to be: Model | Metric_Name | Score_Value\n","    # We use the Normalized Cultural Score here\n","    value_vars = ['Lexical_Score', 'Narrative_Score', 'Cultural_Score_Norm']\n","\n","    df_melt_en = df_en.melt(id_vars=['Model'], value_vars=value_vars,\n","                            var_name='Metric', value_name='Score')\n","\n","    df_melt_bn = df_bn.melt(id_vars=['Model'], value_vars=value_vars,\n","                            var_name='Metric', value_name='Score')\n","\n","    df_melt_comb = df_combined.melt(id_vars=['Model', 'Language'], value_vars=value_vars,\n","                                    var_name='Metric', value_name='Score')\n","\n","    # Rename metrics for cleaner x-axis labels\n","    clean_labels = {\n","        'Lexical_Score': 'Lexical',\n","        'Narrative_Score': 'Narrative',\n","        'Cultural_Score_Norm': 'Cultural (Norm)'\n","    }\n","    df_melt_en['Metric'] = df_melt_en['Metric'].map(clean_labels)\n","    df_melt_bn['Metric'] = df_melt_bn['Metric'].map(clean_labels)\n","    df_melt_comb['Metric'] = df_melt_comb['Metric'].map(clean_labels)\n","\n","    # ---------------------------------------------------------\n","    # 3. VISUALIZATION\n","    # ---------------------------------------------------------\n","    sns.set_theme(style=\"whitegrid\")\n","\n","    # Create a figure with 3 subplots\n","    fig, axes = plt.subplots(1, 3, figsize=(24, 7))\n","    fig.suptitle('Analysis of Cultural Erosion: Where is the signal lost?', fontsize=20, y=1.05)\n","\n","    # --- PLOT 1: ENGLISH ---\n","    sns.barplot(ax=axes[0], x=\"Metric\", y=\"Score\", data=df_melt_en,\n","                palette=\"Blues_d\", errorbar='sd', capsize=.1)\n","    axes[0].set_title(\"English Context: Average Scores\", fontsize=16)\n","    axes[0].set_ylabel(\"Normalized Score (0-1)\")\n","    axes[0].set_ylim(0, 1.1)\n","\n","    # --- PLOT 2: BANGLA ---\n","    sns.barplot(ax=axes[1], x=\"Metric\", y=\"Score\", data=df_melt_bn,\n","                palette=\"Greens_d\", errorbar='sd', capsize=.1)\n","    axes[1].set_title(\"Bangla Context: Average Scores\", fontsize=16)\n","    axes[1].set_ylabel(\"\") # Hide Y label to reduce clutter\n","    axes[1].set_ylim(0, 1.1)\n","\n","    # --- PLOT 3: COMBINED ---\n","    # Comparing languages side-by-side for each metric\n","    sns.barplot(ax=axes[2], x=\"Metric\", y=\"Score\", hue=\"Language\", data=df_melt_comb,\n","                palette=\"viridis\", errorbar='sd', capsize=.1)\n","    axes[2].set_title(\"Comparison: English vs Bangla\", fontsize=16)\n","    axes[2].set_ylabel(\"\")\n","    axes[2].set_ylim(0, 1.1)\n","    axes[2].legend(title=\"Language\")\n","\n","    # Add numeric labels on top of bars for clarity\n","    for ax in axes:\n","        for container in ax.containers:\n","            ax.bar_label(container, fmt='%.2f', padding=3)\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","    print(\"\\n--- Analysis Complete ---\")\n","    print(\"Interpretation Guide:\")\n","    print(\"1. If 'Cultural' is significantly lower than 'Lexical' or 'Narrative', erosion is happening at the deep semantic level.\")\n","    print(\"2. 'Lexical' usually represents surface-level fluency.\")\n","    print(\"3. 'Narrative' represents plot coherence.\")\n","\n","else:\n","    print(\"Could not generate plots due to data loading errors.\")"]}]}