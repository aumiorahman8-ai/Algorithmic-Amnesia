{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"gpuType":"T4","authorship_tag":"ABX9TyNqPvc4DtNLpYVqLt8a4dkF"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"GXms2QT7LnW7","executionInfo":{"status":"ok","timestamp":1761891308730,"user_tz":-360,"elapsed":180138,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"}},"outputId":"e3a6c103-4ca0-48f1-e73b-cd7a6becbfd1"},"outputs":[{"output_type":"stream","name":"stdout","text":["Installing required libraries: google-genai, torch, nltk...\n","Libraries installed successfully.\n","------------------------------\n","NLTK 'punkt' tokenizer downloaded.\n","------------------------------\n","Initializing Gemini Client. Using model: gemini-2.5-pro\n","Gemini Client initialized successfully.\n","------------------------------\n","Mounting Google Drive...\n","Mounted at /content/drive\n","Google Drive mounted successfully.\n","------------------------------\n","Source folder:      /content/drive/MyDrive/Algorithmic Amnesia/Text Corpus/cbs\n","Destination folder: /content/drive/MyDrive/Algorithmic Amnesia/Text Corpus/Translations (Gemini)\n","Source folder found.\n","Destination folder is ready.\n","------------------------------\n","\n","Starting the translation process...\n","\n","Processing 'thakurmar jhuli_brahman brahmani_BN.txt'...\n"," -> SUCCESS: Translated content saved to 'thakurmar jhuli_brahman brahmani_EN.txt'\n","\n","-----------------------------------------\n","Translation process finished.\n","Successfully translated files: 1\n","Skipped empty files: 0\n","Failed files: 0\n","-----------------------------------------\n"]}],"source":["# -*- coding: utf-8 -*-\n","\"\"\"\n","This script automates the translation of Bengali text files to English\n","using the **Google Gemini API**.\n","\n","Workflow:\n","1. Installs necessary Python libraries (google-genai, torch, nltk).\n","2. **Accepts the hardcoded API Key.**\n","3. Mounts the user's Google Drive.\n","4. Initializes the Gemini API client using the provided key.\n","5. Defines paths, verifies source, and creates the destination folder.\n","6. Iterates through files, reads Bengali content, and translates using Gemini.\n","7. Saves the translated English text to a new file.\n","8. Includes error handling and a final summary.\n","\n","*** WARNING: Hardcoding API keys is NOT RECOMMENDED for production or shared code. ***\n","\"\"\"\n","\n","# --- 1. Install Dependencies ---\n","print(\"Installing required libraries: google-genai, torch, nltk...\")\n","!pip install google-genai torch nltk -q\n","print(\"Libraries installed successfully.\")\n","print(\"-\" * 30)\n","\n","import os\n","import sys\n","from google.colab import drive\n","import nltk\n","from google import genai\n","from google.genai.errors import APIError\n","import time\n","\n","# Download the NLTK data\n","try:\n","    nltk.download('punkt', quiet=True)\n","    print(\"NLTK 'punkt' tokenizer downloaded.\")\n","except Exception as e:\n","    print(f\"Warning: Could not download NLTK tokenizers. Error: {e}\")\n","print(\"-\" * 30)\n","\n","\n","# --- 2. PASTE YOUR API KEY HERE (The desired change) ---\n","# ⚠️ SECURITY WARNING: Replace 'YOUR_GEMINI_API_KEY_HERE' with your actual key.\n","# This exposes your key if you share the file. Use Colab Secrets for better security.\n","GEMINI_API_KEY = \"AIzaSyCJXodGhgA885BSKa1qmN2hblPAMgcFBB4\"\n","MODEL_NAME = \"gemini-2.5-pro\"\n","\n","\n","# --- 3. Initialize the Gemini API Client with the hardcoded key ---\n","print(f\"Initializing Gemini Client. Using model: {MODEL_NAME}\")\n","try:\n","    # Pass the API key directly to the Client constructor\n","    client = genai.Client(api_key=GEMINI_API_KEY)\n","\n","    # Simple check to ensure the key is not the placeholder\n","    if GEMINI_API_KEY == \"YOUR_GEMINI_API_KEY_HERE\":\n","        sys.exit(\"ERROR: Please replace 'YOUR_GEMINI_API_KEY_HERE' with your actual Gemini API Key.\")\n","\n","    print(\"Gemini Client initialized successfully.\")\n","except Exception as e:\n","    print(f\"Failed to initialize Gemini Client. Check your API Key.\")\n","    print(f\"Error: {e}\")\n","    sys.exit(\"Script stopped. Could not initialize the Gemini Translator.\")\n","print(\"-\" * 30)\n","\n","\n","# --- 4. Mount Google Drive ---\n","print(\"Mounting Google Drive...\")\n","try:\n","    drive.mount('/content/drive')\n","    print(\"Google Drive mounted successfully.\")\n","except Exception as e:\n","    print(f\"An error occurred while mounting Google Drive: {e}\")\n","    sys.exit(\"Script stopped due to Drive mounting failure.\")\n","print(\"-\" * 30)\n","\n","\n","# --- 5. Set up File Paths ---\n","# !!! IMPORTANT: Please verify this path is correct in your Drive !!!\n","base_path = '/content/drive/MyDrive/Algorithmic Amnesia/Text Corpus/'\n","source_folder = os.path.join(base_path, 'cbs')\n","destination_folder = os.path.join(base_path, 'Translations (Gemini)')\n","\n","print(f\"Source folder:      {source_folder}\")\n","print(f\"Destination folder: {destination_folder}\")\n","\n","\n","# --- 6. Verify Source and Create Destination Directories ---\n","if not os.path.isdir(source_folder):\n","    print(f\"\\nError: Source folder not found at '{source_folder}'\")\n","    sys.exit(\"Please check your folder structure and try again.\")\n","else:\n","    print(\"Source folder found.\")\n","\n","try:\n","    os.makedirs(destination_folder, exist_ok=True)\n","    print(f\"Destination folder is ready.\")\n","except OSError as e:\n","    print(f\"Error creating destination folder '{destination_folder}': {e}\")\n","    sys.exit(\"Script stopped due to a filesystem error.\")\n","print(\"-\" * 30)\n","\n","\n","# --- 7. Translation Function (Central Logic) ---\n","def translate_text_with_gemini(text_to_translate):\n","    \"\"\"Translates a block of text using the Gemini API.\"\"\"\n","    prompt = (\n","        \"Translate the following Bengali text into clear, fluent English. \"\n","        \"Preserve the paragraph structure and do not include any extra commentary, \"\n","        \"notes, or introductory phrases (like 'Here is the translation:'). \"\n","        \"Only output the translated English text.\"\n","        f\"\\n\\nBengali Text:\\n---\\n{text_to_translate}\\n---\"\n","    )\n","\n","    try:\n","        response = client.models.generate_content(\n","            model=MODEL_NAME,\n","            contents=prompt,\n","            config=dict(temperature=0.3)\n","        )\n","        return response.text.strip()\n","\n","    except APIError as e:\n","        print(f\"  -> API Error during translation: {e}\")\n","        return None\n","    except Exception as e:\n","        print(f\"  -> An unexpected error occurred: {e}\")\n","        return None\n","\n","\n","# --- 8. Process and Translate Files ---\n","print(\"\\nStarting the translation process...\")\n","processed_files = 0\n","skipped_files = 0\n","failed_files = 0\n","REQUEST_DELAY_SECONDS = 5 # Add a delay to respect API rate limits\n","\n","try:\n","    all_files = os.listdir(source_folder)\n","    files_to_process = [f for f in all_files if f.endswith('_BN.txt')]\n","\n","    if not files_to_process:\n","        print(\"Warning: No files ending with '_BN.txt' were found in the source folder.\")\n","except FileNotFoundError:\n","    print(f\"Critical Error: Could not list files in '{source_folder}'.\")\n","    sys.exit(\"Script stopped.\")\n","\n","\n","for filename in files_to_process:\n","    source_filepath = os.path.join(source_folder, filename)\n","    english_filename = filename.replace('_BN.txt', '_EN.txt')\n","    destination_filepath = os.path.join(destination_folder, english_filename)\n","\n","    print(f\"\\nProcessing '{filename}'...\")\n","\n","    try:\n","        with open(source_filepath, 'r', encoding='utf-8-sig') as f:\n","            bengali_text = f.read()\n","\n","        if not bengali_text.strip():\n","            print(f\" -> WARNING: File is empty. Skipping.\")\n","            skipped_files += 1\n","            continue\n","\n","        # Perform the translation\n","        english_text = translate_text_with_gemini(bengali_text)\n","\n","        if english_text:\n","            with open(destination_filepath, 'w', encoding='utf-8') as f:\n","                f.write(english_text)\n","\n","            print(f\" -> SUCCESS: Translated content saved to '{english_filename}'\")\n","            processed_files += 1\n","        else:\n","            print(f\" -> FAILURE: Translation failed for '{filename}'. Check error message above.\")\n","            failed_files += 1\n","\n","    except FileNotFoundError:\n","        print(f\" -> ERROR: Could not find '{filename}' during processing.\")\n","        failed_files += 1\n","    except Exception as e:\n","        print(f\" -> ERROR: An unexpected error occurred on file '{filename}': {e}\")\n","        failed_files += 1\n","\n","    # Introduce a delay to prevent hitting API rate limits\n","    time.sleep(REQUEST_DELAY_SECONDS)\n","\n","\n","print(\"\\n-----------------------------------------\")\n","print(\"Translation process finished.\")\n","print(f\"Successfully translated files: {processed_files}\")\n","print(f\"Skipped empty files: {skipped_files}\")\n","print(f\"Failed files: {failed_files}\")\n","print(\"-----------------------------------------\")"]}]}