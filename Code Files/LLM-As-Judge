eptions.ResourceExhausted as e:\n","        # This error means 429: Too Many Requests\n","        # It could be RPM (Wait 1 min) or Daily Limit (Wait 24 hrs)\n","        if \"429\" in str(e):\n","            return \"❌ QUOTA HIT (Dead for now)\"\n","        return \"❌ EXHAUSTED\"\n","\n","    except exceptions.InvalidArgument:\n","        return \"🚫 INVALID KEY\"\n","\n","    except Exception as e:\n","        return f\"⚠ ERROR: {str(e)[:20]}...\"\n","\n","def main():\n","    if not os.path.exists(KEYS_PATH):\n","        print(\"Keys file not found!\")\n","        return\n","\n","    with open(KEYS_PATH, 'r') as f:\n","        keys = [line.strip() for line in f if line.strip()]\n","\n","    print(f\"Testing {len(keys)} keys...\\n\")\n","\n","    print(f\"{'Key Suffix':<15} | {'Status'}\")\n","    print(\"-\" * 40)\n","\n","    active_count = 0\n","\n","    for key in keys:\n","        status = check_key(key)\n","        suffix = f\"...{key[-4:]}\"\n","        print(f\"{suffix:<15} | {status}\")\n","\n","        if \"ALIVE\" in status:\n","            active_count += 1\n","\n","    print(\"-\" * 40)\n","    print(f\"\\nSummary: {active_count}/{len(keys)} keys are ready to use.\")\n","\n","    if active_count == 0:\n","        print(\"💀 All keys are exhausted. You need to wait for tomorrow (Midnight Pacific Time).\")\n","\n","if __name__ == \"__main__\":\n","    main()"]}],"metadata":{"colab":{"provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"},"widgets":{"application/vnd.jupyter.widget-state+json":{"0e8af63ac9c64a968f0b96197dc59b11":{"model_module":"@jupyter-widgets/controls","model_module_version":"1.5.0","model_name":"DescriptionStyleModel","state":{"_model_module":"@jupyter-widgets/controls","_model_module_version":"1.5.0","_model_name":"DescriptionStyleModel","_view_count":null,"_view_module":"@jupyter-widgets/base","_view_module_version":"1.2.0","_view_name":"StyleView","description_width":""}},"184ee010fe