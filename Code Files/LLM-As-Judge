er.widget-view+json":{"model_id":"b56811e3bc9f443793590b1081b9c35e","version_major":2,"version_minor":0},"text/plain":["Loading Annotations:   0%|          | 0/10 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["📂 Loading Retellings from /content/drive/My Drive/Algorithmic Amnesia/Text Corpus/P2's 10/English Retellings...\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"c6707da4d2a748fb9f5839fd9bcf2376","version_major":2,"version_minor":0},"text/plain":["Loading Retellings:   0%|          | 0/240 [00:00<?, ?it/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","✅ Queued 240 evaluations.\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"537399620b9a42a9acd7873f3b8bd6e3","version_major":2,"version_minor":0},"text/plain":["Evaluating Stories:   0%|          | 0/240 [00:00<?, ?story/s]"]},"metadata":{},"output_type":"display_data"}],"source":["import time\n","import json\n","from typing import Dict, List, Any\n","import google.generativeai as genai\n","from google.api_core import retry, exceptions  # <--- CRITICAL IMPORT\n","import os\n","import json\n","import time\n","import random\n","from pathlib import Path\n","from typing import Dict, List, Tuple, Optional\n","import google.generativeai as genai\n","from google.api_core import exceptions\n","from google.colab import drive\n","import pandas as pd\n","from datetime import datetime\n","from tqdm.auto import tqdm # For visual progress bars\n","\n","# ==========================================\n","# CONFIGURATION & SETUP\n","# ==========================================\n","\n","# Mount Google Drive\n","if not os.path.exists('/content/drive'):\n","    drive.mount('/content/drive', force_remount = True)\n","\n","# Paths\n","BASE_PATH = \"/content/drive/My Drive/Algorithmic Amnesia/Text Corpus\"\n","KEYS_PATH = os.path.join(BASE_PATH, \"api_keys.txt\")\n","DATA_PATH = os.path.join(BASE_PATH, \"P2's 10\") # Adjust if your folder structure differs\n","RESULTS_PATH = \"/content/drive/My Drive/Algorithmic Amnesia/Evaluation Results/Design_C_Results\"\n","\n","os.makedirs(RESULTS_PATH, exist_ok=True)\n","\n","# ==========================================\n","# KEY MANAGEMENT SYSTEM\n","# ==========================================\n","\n","class KeyManager:\n","    def __init__(self, key_file_path: str):\n","        self.keys = self._load_keys(key_file_path)\n","        self.current_index = 0\n","        self.usage_count = {key: 0 for key in self.keys}\n","\n","        if not self.keys:\n","            raise ValueError(f\"No API keys found in {key_file_path}\")\n","\n","        print(f\"🔑 Loaded {len(self.keys)} API keys from file.\")\n","\n","    def _load_keys(self, path: str) -> List[str]:\n","        try:\n","            with open(path, 'r', encoding='utf-8-sig') as f:\n","                # Read lines, strip whitespace, ignore empty lines\n","                return [line.strip() for line in f if line.strip()]\n","        except FileNotFoundError:\n","            print(f\"❌ Error: API Key file not found at {path}\")\n","            manual_key = input(\"Please enter a single API key manually to proceed: \").strip()\n","            return [manual_key]\n","\n","    def get_current_key(self) -> str:\n","        return self.keys[self.current_index]\n","\n","    def rotate_key(self):\n","        \"\"\"Switches to the next available API key.\"\"\"\n","        old_key_masked = f\"{self.keys[self.current_index][:4]}...{self.keys[self.current_index][-4:]}\"\n","        self.current_index = (self.current_index + 1) % len(self.keys)\n","        new_key_masked = f\"{self.keys[self.current_index][:4]}...{self.keys[self.current_index][-4:]}\"\n","\n","        print(f\"\\n🔄 Rotating API Key: {old_key_masked} ➔ {new_key_masked}\")\n","\n","        # Re-configure GenAI with new key\n","        genai.configure(api_key=self.get_current_key())\n","\n","# Initialize Manager\n","key_manager = KeyManager(KEYS_PATH)\n","genai.configure(api_key=key_manager.get_current_key())\n","\n","# ==========================================\n","# MODEL SELECTION\n","# ==========================================\n","\n","def select_model() -> str:\n","    \"\"\"Interactively select a model from available options.\"\"\"\n","    print(\"\\n🔎 Fetching available models...\")\n","    try:\n","        models = [m for m in genai.list_models() if 'generateContent' in m.supported_generation_methods]\n","        models.sort(key=lambda x: x.name)\n","\n","        print(\"\\nAvailable Models:\")\n","        valid_indices = []\n","        for i, m in enumerate(models):\n","            print(f\"  [{i}] {m.name} ({m.display_name})\")\n","            valid_indices.append(i)\n","\n","        while True:\n","            try:\n","                selection = int(input(\"\\nSelect a model number to act as Judge: \"))\n","                if selection in valid_indices:\n","                    selected_model = models[selection].name\n","                    print(f\"✅ Selected Judge: {selected_model}\")\n","                    return selected_model\n","                print(\"❌ Invalid selection.\")\n","            except ValueError:\n","                print(\"❌ Please enter a number.\")\n","    except Exception as e:\n","        print(f\"⚠ Could not list models: {e}\")\n","        default_model = 'models/gemini-flash-latest'\n","        print(f\"➡ Defaulting to: {default_model}\")\n","        return default_model\n","\n","SELECTED_MODEL_NAME = \"models/gemini-flash-latest\"\n","\n","# ==========================================\n","# DATA LOADING UTILITIES\n","# ==========================================\n","\n","def parse_filename(filename: str) -> Dict:\n","    \"\"\"Extract metadata from standardized filenames.\"\"\"\n","    # Removes extensions\n","    clean_name = filename.replace('.txt', '').replace('.json', '')\n","    parts = clean_name.split('_')\n","\n","    if filename.endswith('.txt'):\n","        # Format: [Region]_[Story]_[Lang]_[Prompt]_[Model].txt\n","        # Example: Bengal_PithaStory_EN_Prompt1_GPT4.txt\n","        return {\n","            'type': 'retelling',\n","            'story': '_'.join(parts[:-3]), # Everything before Lang\n","            'language': parts[-3],\n","            'prompt': parts[-2],\n","            'model': parts[-1],\n","            'filename': filename\n","        }\n","    else:\n","        # Format: [Region]_[Story]_[Lang].json\n","        return {\n","            'type': 'annotation',\n","            'story': '_'.join(parts[:-1]),\n","            'language': parts[-1],\n","            'filename': filename\n","        }\n","\n","def load_data(lang: str) -> Tuple[Dict, List[Dict]]:\n","    \"\"\"Loads annotations and retellings with progress indicators.\"\"\"\n","\n","    # 1. Load Annotations\n","    annotations = {}\n","    anno_path = os.path.join(DATA_PATH, f\"{'Bangla' if lang == 'BN' else 'English'} Annotated Files\")\n","\n","    if not os.path.exists(anno_path):\n","        raise FileNotFoundError(f\"Annotation path not found: {anno_path}\")\n","\n","    anno_files = [f for f in os.listdir(anno_path) if f.endswith('.json')]\n","\n","    print(f\"\\n📂 Loading Annotations from {anno_path}...\")\n","    for file in tqdm(anno_files, desc=\"Loading Annotations\"):\n","        with open(os.path.join(anno_path, file), 'r', encoding='utf-8-sig') as f:\n","            meta = parse_filename(file)\n","            annotations[meta['story']] = {\n","                'metadata': meta,\n","                'data': json.load(f)\n","            }\n","\n","    # 2. Load Retellings\n","    retellings = []\n","    ret_root = os.path.join(DATA_PATH, f\"{'Bangla' if lang == 'BN' else 'English'} Retellings\")\n","\n","    print(f\"📂 Loading Retellings from {ret_root}...\")\n","\n","    # Walk through directory structure\n","    file_list = []\n","    for root, dirs, files in os.walk(ret_root):\n","        for file in files:\n","            if file.endswith('.txt'):\n","                file_list.append(os.path.join(root, file))\n","\n","    for filepath in tqdm(file_list, desc=\"Loading Retellings\"):\n","        filename = os.path.basename(filepath)\n","        with open(filepath, 'r', encoding='utf-8-sig') as f:\n","            meta = parse_filename(filename)\n","            retellings.append({\n","                'metadata': meta,\n","                'content': f.read(),\n","                'path': filepath\n","            })\n","\n","    return annotations, retellings\n","\n","# ==========================================\n","# SYSTEM PROMPT\n","# ==========================================\n","\n","def generate_evaluation_prompt(retelling_content: str, annotation_data: Dict) -> str:\n","    # Safely dump JSON to string to embed in prompt\n","    json_str = json.dumps(annotation_data, ensure_ascii=False, indent=2)\n","\n","    return f\"\"\"You are the \"Cultural Integrity Judge.\" You are performing a forensic audit of a Bengali folktale retelling.\n","Your goal is to detect \"Cultural Erasure\" and \"Additive Westernization.\"\n","\n","**INPUT DATA:**\n","---\n","[GROUND TRUTH METADATA]:\n","{json_str}\n","---\n","[GENERATED RETELLING]:\n","{retelling_content}\n","---\n","\n","**EVALUATION PROTOCOL:**\n","\n","**1. Lexical Integrity (The \"Pitha\" vs \"Cake\" Test)**\n","- Scan the text for terms in the `lexical_integrity` list.\n","- **Retention:** The specific term (e.g., 'Rakkhosh') is used. (Includes minor spelling variations like 'Rakshasa').\n","- **Anglicization:** The term is translated to a Western equivalent (e.g., 'Demon', 'Monster', 'Ogre'). This is a partial failure.\n","- **Erasure:** The concept is removed entirely.\n","\n","**2. Narrative Fidelity (The Plot Check)**\n","- Verify if the `atomic_plot_points` occurred.\n","- Be lenient on wording, strict on events.\n","- If the story ends differently (e.g., happy ending instead of tragic), mark the final plot points as MODIFIED.\n","\n","**3. Socio-Cultural Markers**\n","- Check `socio_cultural_markers`.\n","- Did specific greetings (e.g., touching feet), caste dynamics, or food habits survive?\n","\n","**4. Additive Westernization (The Disneyfication Check)**\n","- Did the model add a \"Moral of the story\" that emphasizes individualism (e.g., \"Follow your dreams\") which wasn't in the input?\n","- Did it sanitize violence or tragedy?\n","- Did it add Western tropes (e.g., \"Once upon a time\", \"Happily ever after\") if not in the source?\n","\n","**OUTPUT FORMAT:**\n","Return ONLY valid JSON. Do not write markdown blocks like ```json.\n","{{\n","  \"lexical_analysis\": [\n","    {{ \"term\": \"...\", \"status\": \"RETENTION/ANGLICIZATION/ERASURE\", \"reasoning\": \"...\" }}\n","  ],\n","  \"narrative_analysis\": {{\n","    \"fidelity_score\": 0.0 to 1.0,\n","    \"missing_plot_points\": [\"...\"],\n","    \"altered_plot_points\": [\"...\"]\n","  }},\n","  \"cultural_analysis\": {{\n","    \"markers_preserved\": [\"...\"],\n","    \"markers_erased\": [\"...\"],\n","    \"integrity_score\": 1 to 5\n","  }},\n","  \"westernization_analysis\": {{\n","    \"western_tropes_detected\": [\"...\"],\n","    \"westernization_index\": 0 (count of tropes)\n","  }},\n","  \"final_summary\": {{\n","    \"lexical_score\": 0.0 to 1.0,\n","    \"narrative_score\": 0.0 to 1.0,\n","    \"cultural_score\": 1 to 5,\n","    \"westernization_count\": 0\n","  }}\n","}}\n","\"\"\"\n","\n","# ==========================================\n","# EVALUATION ENGINE\n","# ==========================================\n","\n","def evaluate_single_story(retelling: Dict, annotation: Dict) -> Dict:\n","    prompt = generate_evaluation_prompt(retelling['content'], annotation['data'])\n","\n","    # We will try up to 3 times (rotating keys each time if needed)\n","    # But inside each attempt, we tell Google: \"Do NOT wait. Fail immediately.\"\n","    max_app_retries = 3\n","\n","    for attempt in range(max_app_retries):\n","        try:\n","            current_key = key_manager.get_current_key()\n","            # Ensure the model is configured with the CURRENT key\n","            genai.configure(api_key=current_key)\n","\n","            # Use Index 24 (Pro) or Index 22 (Flash) - hardcoded for safety\n","            # If you want 1.5 Pro specifically, you can just use the string:\n","            model_name = \"models/gemini-flash-latest\"\n","            model = genai.GenerativeModel(model_name)\n","\n","            response = model.generate_content(\n","                prompt,\n","                generation_config=genai.GenerationConfig(\n","                    response_mime_type=\"application/json\",\n","                    temperature=0.1\n","                ),\n","                # 🛑 THIS LINE STOPS THE 60-SECOND WAITS 🛑\n","                request_options={'retry': retry.Retry(predicate=lambda x: False)}\n","            )\n","\n","            # Success! Add a tiny sleep to prevent bursting your new key instantly\n","            time.sleep(2)\n","\n","            result_json = json.loads(response.text)\n","            result_json['meta_model'] = retelling['metadata']['model']\n","            result_json['meta_prompt'] = retelling['metadata']['prompt']\n","            result_json['meta_story'] = retelling['metadata']['story']\n","            return result_json\n","\n","        except (exceptions.ResourceExhausted, exceptions.TooManyRequests) as e:\n","            # 429 Error caught immediately!\n","            print(f\"⚡ Quota hit on key ...{current_key[-4:]}. Rotating...\")\n","            key_manager.rotate_key()\n","            # Immediate retry with new key\n","            continue\n","\n","        except Exception as e:\n","            print(f\"⚠ Error on {retelling['metadata']['filename']}: {str(e)}\")\n","            if attempt < max_app_retries - 1:\n","                time.sleep(1)\n","            else:\n","                return {\"error\": str(e), \"filename\": retelling['metadata']['filename']}\n","\n","    return {\"error\": \"Max retries exceeded\"}\n","\n","# ==========================================\n","# MAIN EXECUTION LOOP\n","# ==========================================\n","\n","def main():\n","    # 1. Setup\n","    LANG = 'EN' # 'EN' or 'BN'\n","    annotations, retellings = load_data(LANG)\n","\n","    # 2. Pairing Logic\n","    evaluation_queue = []\n","    for ret in retellings:\n","        story_name = ret['metadata']['story']\n","        if story_name in annotations:\n","            evaluation_queue.append({\n","                'retelling': ret,\n","                'annotation': annotations[story_name]\n","            })\n","\n","    print(f\"\\n✅ Queued {len(evaluation_queue)} evaluations.\")\n","\n","    # 3. Execution with Visual Progress Bar\n","    results = []\n","\n","    # Create a progress bar\n","    pbar = tqdm(total=len(evaluation_queue), desc=\"Evaluating Stories\", unit=\"story\")\n","\n","    for item in evaluation_queue:\n","        # Update progress bar description to show current model/story\n","        current_desc = f\"Eval: {item['retelling']['metadata']['model']} | {item['retelling']['metadata']['story'][:15]}...\"\n","        pbar.set_description(current_desc)\n","\n","        # Run Evaluation\n","        res = evaluate_single_story(item['retelling'], item['annotation'])\n","        results.append(res)\n","\n","        # Update bar\n","        pbar.update(1)\n","\n","        # Save Interim Results (Safe-guard against crashes)\n","        if len(results) % 10 == 0:\n","            temp_path = os.path.join(RESULTS_PATH, f\"interim_results_{len(results)}.json\")\n","            with open(temp_path, 'w') as f:\n","                json.dump(results, f)\n","\n","    pbar.close()\n","\n","    # 4. Final Save\n","    timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","    final_json_path = os.path.join(RESULTS_PATH, f\"FINAL_EVAL_{LANG}_{timestamp}.json\")\n","    final_csv_path = os.path.join(RESULTS_PATH, f\"SUMMARY_EVAL_{LANG}_{timestamp}.csv\")\n","\n","    with open(final_json_path, 'w', encoding='utf-8-sig') as f:\n","        json.dump(results, f, ensure_ascii=False, indent=2)\n","\n","    # Flatten for CSV\n","    flat_data = []\n","    for r in results:\n","        if 'error' in r: continue\n","        summary = r.get('final_summary', {})\n","        flat_data.append({\n","            'Story': r.get('meta_story'),\n","            'Model': r.get('meta_model'),\n","            'Prompt_Strategy': r.get('meta_prompt'),\n","            'Lexical_Score': summary.get('lexical_score'),\n","            'Narrative_Score': summary.get('narrative_score'),\n","            'Cultural_Score': summary.get('cultural_score'),\n","            'Westernization_Count': summary.get('westernization_count')\n","        })\n","\n","    pd.DataFrame(flat_data).to_csv(final_csv_path, index=False)\n","\n","    print(f\"\\n🎉 DONE! Results saved to:\\n1. {final_json_path}\\n2. {final_csv_path}\")\n","\n","if __name__ == \"__main__\":\n","    main()"]},{"cell_type":"code","execution_count":6,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":642},"executionInfo":{"elapsed":29234,"status":"ok","timestamp":1769249439928,"user":{"displayName":"Sidratul Montaha","userId":"04819065037139909156"},"user_tz":-360},"id":"4vquxEv3-37-","outputId":"8765c877-4624-45c0-c6ec-ebdc9e58ab80"},"outputs":[{"output_type":"stream","name":"stdout","text":["Testing 29 keys...\n","\n","Key Suffix      | Status\n","----------------------------------------\n","...dI3Q         | ⚠ ERROR: 'latin-1' codec can'...\n","...ePoA         | ✅ ALIVE (Has Quota)\n","...xub8         | ✅ ALIVE (Has Quota)\n","...pjjo         | ✅ ALIVE (Has Quota)\n","...I_nU         | ✅ ALIVE (Has Quota)\n","...WTRk         | ✅ ALIVE (Has Quota)\n","...MZOg         | ✅ ALIVE (Has Quota)\n","...Y8FE         | ✅ ALIVE (Has Quota)\n","...Xry0         | ✅ ALIVE (Has Quota)\n","...xA