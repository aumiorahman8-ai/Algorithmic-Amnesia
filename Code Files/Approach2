   You MUST replace the placeholder with code that converts Doccano's character-based\n","    spans into token-based IOB2 tags ('B-TAG', 'I-TAG', 'O').\n","    \"\"\"\n","\n","    def _process_file(filepath):\n","        \"\"\"Processes a single Doccano JSONL file.\"\"\"\n","        # This check is to ensure the user has created the files.\n","        if not os.path.exists(filepath):\n","            raise FileNotFoundError(\n","                f\"The specified annotation file was not found: {filepath}\\n\"\n","                \"Please make sure you have created this file and the path is correct.\"\n","            )\n","\n","        processed_data = []\n","        with open(filepath, 'r', encoding='utf-8') as f:\n","            for line in f:\n","                doccano_item = json.loads(line)\n","\n","                # --- START OF CRITICAL CONVERSION LOGIC ---\n","                # You must implement the logic to convert the Doccano format to the Hugging Face format.\n","                #\n","                # A `doccano_item` from a JSONL export looks like this:\n","                # {'id': 1, 'text': 'এক যে ছিল রাজা।', 'label': [[0, 14, 'STR-OralMarker']]}\n","                #\n","                # Your goal is to convert it into this format for the Dataset:\n","                # {'id': 1, 'tokens': ['এক', 'যে', 'ছিল', 'রাজা', '।'], 'ner_tags': ['B-STR-OralMarker', 'I-STR-OralMarker', 'I-STR-OralMarker', 'I-STR-OralMarker', 'O']}\n","                #\n","                # This usually involves:\n","                # 1. Tokenizing the `doccano_item['text']` (e.g., using spacy or simple splitting).\n","                # 2. Creating a list of 'O' (Outside) tags, one for each token.\n","                # 3. Looping through `doccano_item['label']` (the list of annotations).\n","                # 4. For each annotation, finding which tokens fall within its character span `[start, end]`.\n","                # 5. Updating the tags list for those tokens to 'B-LABEL' (Beginning) and 'I-LABEL' (Inside).\n","\n","                # Replace the following placeholder with your actual converted data.\n","                # This placeholder WILL CAUSE AN ERROR until you implement the conversion.\n","                processed_item = {\n","                    'id': doccano_item.get('id'),\n","                    'tokens': [],  # <-- POPULATE THIS with tokens from doccano_item['text']\n","                    'ner_tags': [] # <-- POPULATE THIS with IOB2 tags based on doccano_item['label']\n","                }\n","                # --- END OF CRITICAL CONVERSION LOGIC ---\n","\n","                # For the script to run, you must ensure 'tokens' and 'ner_tags' are populated.\n","                if not processed_item['tokens'] or not processed_item['ner_tags']:\n","                    raise ValueError(f\"Data conversion not implemented for item: {doccano_item}\")\n","\n","                processed_data.append(processed_item)\n","\n","        return Dataset.from_list(processed_data)\n","\n","    print(f\"Loading training data from: {train_filepath}\")\n","    train_dataset = _process_file(train_filepath)\n","\n","    print(f\"Loading validation data from: {val_filepath}\")\n","    validation_dataset = _process_file(val_filepath)\n","\n","    print(f\"Loading test data from: {test_filepath}\")\n","    test_dataset = _process_file(test_filepath)\n","\n","    return DatasetDict({\n","        'train': train_dataset,\n","        'validation': validation_dataset,\n","        'test': test_dataset\n","    })\n","\n","# --- TOKENIZATION & LABEL ALIGNMENT ---\n","\n","def tokenize_and_align_labels(examples, tokenizer, label_map):\n","    tokenized_inputs = tokenizer(examples[\"tokens\"], truncation=True, is_split_into_words=True)\n","\n","    labels = []\n","    for i, label in enumerate(examples[f\"ner_tags\"]):\n","        word_ids = tokenized_inputs.word_ids(batch_index=i)\n","        previous_word_idx = None\n","        label_ids = []\n","        for word_idx in word_ids:\n","            if word_idx is None:\n","                label_ids.append(-100)\n","            elif word_idx != previous_word_idx:\n","                label_ids.append(label_map[label[word_idx]])\n","            else:\n","                # This handles sub-words. For simplicity, we only label the first sub-word.\n","                # A common scheme is to use IOB2 (Inside, Outside, Beginning)\n","                label_ids.append(-100)\n","            previous_word_idx = word_idx\n","        labels.append(label_ids)\n","\n","    tokenized_inputs[\"labels\"] = labels\n","    return tokenized_inputs\n","\n","# --- METRICS CALCULATION ---\n","\n","def compute_metrics(p, id_to_label):\n","    predictions, labels = p\n","    predictions = np.argmax(predictions, axis=2)\n","\n","    true_predictions = [\n","        [id_to_label[p] for (p, l) in zip(prediction, label) if l != -100]\n","        for prediction, label in zip(predictions, labels)\n","    ]\n","    true_labels = [\n","        [id_to_label[l] for (p, l) in zip(prediction, label) if l != -100]\n","        for prediction, label in zip(predictions, labels)\n","    ]\n","\n","    seqeval = evaluate.load(\"seqeval\")\n","    results = seqeval.compute(predictions=true_predictions, references=true_labels)\n","    return {\n","        \"precision\": results[\"overall_precision\"],\n","        \"recall\": results[\"overall_recall\"],\n","        \"f1\": results[\"overall_f1\"],\n","        \"accuracy\": results[\"overall_accuracy\"],\n","    }\n","\n","# --- MAIN EXECUTION ---\n","\n","if __name__ == '__main__':\n","    print(\"--- Starting Transformer NER Fine-Tuning ---\")\n","\n","    # 1. Load and prepare dataset from your predefined files\n","    raw_datasets = load_from_predefined_splits(TRAIN_FILE, VALIDATION_FILE, TEST_FILE)\n","    print(f\"Dataset loaded from custom files:\\n{raw_datasets}\")\n","\n","    # 2. Create label mappings from all splits\n","    all_tags = set(tag for split in raw_datasets.values() for example in split for tag in example['ner_tags'])\n","    label_list = sorted(list(all_tags))\n","    label_to_id = {l: i for i, l in enumerate(label_list)}\n","    id_to_label = {i: l for i, l in enumerate(label_list)}\n","    num_labels = len(label_list)\n","\n","    print(f\"\\nFound {num_labels} unique labels: {label_list}\")\n","\n","    # 3. Initialize tokenizer\n","    tokenizer = AutoTokenizer.from_pretrained(MODEL_CHECKPOINT)\n","\n","    # 4. Tokenize datasets and align labels\n","    tokenized_datasets = raw_datasets.map(\n","        tokenize_and_align_labels,\n","        batched=True,\n","        fn_kwargs={\"tokenizer\": tokenizer, \"label_map\": label_to_id}\n","    )\n","\n","    # 5. Initialize model\n","    model = AutoModelForTokenClassification.from_pretrained(\n","        MODEL_CHECKPOINT, num_labels=num_labels, id2label=id_to_label, label2id=label_to_id\n","    )\n","\n","    # 6. Set up training arguments\n","    args = TrainingArguments(\n","        output_dir=MODEL_OUTPUT_DIR,\n","        evaluation_strategy=\"epoch\",\n","        learning_rate=LEARNING_RATE,\n","        per_device_train_batch_size=BATCH_SIZE,\n","        per_device_eval_batch_size=BATCH_SIZE,\n","        num_train_epochs=NUM_EPOCHS,\n","        weight_decay=WEIGHT_DECAY,\n","        push_to_hub=False,\n","    )\n","\n","    # 7. Data collator for padding\n","    data_collator = DataCollatorForTokenClassification(tokenizer=tokenizer)\n","\n","    # 8. Initialize Trainer\n","    trainer = Trainer(\n","        model,\n","        args,\n","        train_dataset=tokenized_datasets[\"train\"],\n","        eval_dataset=tokenized_datasets[\"validation\"],\n","        data_collator=data_collator,\n","        tokenizer=tokenizer,\n","        compute_metrics=lambda p: compute_metrics(p, id_to_label),\n","    )\n","\n","    # 9. Train the model\n","    print(\"\\n--- Starting model training ---\")\n","    trainer.train()\n","\n","    # 10. Evaluate the model on the test set\n","    print(\"\\n--- Evaluating on the test set ---\")\n","    eval_results = trainer.evaluate(tokenized_datasets[\"test\"])\n","    print(eval_results)\n","\n","    # 11. Save the model\n","    trainer.save_model(MODEL_OUTPUT_DIR)\n","    print(f\"\\n--- Model saved to {MODEL_OUTPUT_DIR} ---\")"],"metadata":{"id":"BmL4xdXH8OZA"},"execution_count":null,"outputs":[]}]}